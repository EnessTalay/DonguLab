{
  "expo": {
    "name": "DöngüLab",
    "slug": "dongulab",
    "version": "0.1.0",
    "scheme": "dongulab",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "web": {
