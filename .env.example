# Default demo needs no Supabase account. Restart Expo after editing this file.
EXPO_PUBLIC_DATA_MODE=demo
# For a configured server, set mode=supabase and fill BOTH values below.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a service-role/secret key into EXPO_PUBLIC_* variables or this repo.
